# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (the Vite dev server + your prod domain)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/noema
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/noema?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/noema

# ── Email notifications (optional) ───────────────────────
# Leave MAIL_HOST empty to disable outbound email; submissions are still saved to the DB.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
# Where contact-form notifications are delivered:
MAIL_TO=info@noematechnology.com
MAIL_FROM="Noema Website <no-reply@noematechnology.com>"

# Website admin. Set a unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional absolute path on a persistent disk (default: server/data/site-content.json).
# SITE_CONTENT_FILE=

